{
  "name": "veyra-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Veyra Health API",
  "type": "module",
  "scripts": {
    "dev": "prisma migrate deploy && prisma db seed && tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "prisma migrate deploy && prisma db seed && node dist/server.js",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@prisma/client": "^6.19.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "jose": "^6.1.0",
    "pdfjs-dist": "^5.4.624",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/node": "^22.13.10",
    "prisma": "^6.19.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
